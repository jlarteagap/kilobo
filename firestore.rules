rules_version = '2';

// Segunda capa de defensa. Todo acceso real pasa por firebase-admin en el
// servidor, que bypasea estas reglas; por eso se deniega todo al cliente.
//
// No es decorativo: hoy ninguna ruta importa `firebase/firestore`, pero una
// importación accidental futura quedaría bloqueada por estas reglas en lugar
// de exponer los datos. `scripts/verify-no-client-firestore.ts` falla si eso
// cambia.
//
// Ninguna regla concede permisos, se niegan todas explícitamente.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}